{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f $HOME/.ai-memory/sync.sh && bash $HOME/.ai-memory/sync.sh || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f $HOME/.ai-memory/sync.sh && bash $HOME/.ai-memory/sync.sh || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.kira/hooks/discipline.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.kira/hooks/guard_skill_write.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.kira/hooks/verify_edit.sh"
          }
        ]
      }
    ]
  },
  "autoMemoryDirectory": "~/.ai-memory",
  "autoDreamEnabled": true,
  "skipAutoPermissionPrompt": true,
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "gitlab.com",
        "github.com",
        "secretsmanager.us-west-1.amazonaws.com",
        "sts.us-west-1.amazonaws.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  }
}
