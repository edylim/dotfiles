#!/usr/bin/env bash
# claude — thin-client shim. Claude Code runs on the kira box (the single Claude
# surface), never locally. Symlinked onto PATH ahead of ~/.local/bin (cutover).
#
#   claude                  create a NEW Claude session per launch in a tmux window on
#                           the box's `-L kira` socket (survives ssh drops; Kira's
#                           StudioControl can observe it; run it again for another one).
#   claude <args…>          run `claude <args>` on the box in the mapped project dir
#                           (ephemeral; e.g. --resume, --model). `-p/--print` runs headless.
#   claude --local <args…>  run the REAL local binary on THIS machine (explicit fallback).
#   KIRA_CLAUDE_HOST=local  force local for the whole shell.
#   KIRA_CLAUDE_TMUX=0      bare `claude` uses ephemeral `--continue` instead of a tmux window.
#
# The box is the ONLY default surface: if it is unreachable, the shim ERRORS and prints
# the local-binary path — it NEVER silently runs local; you must ask for it via --local.
#
# Design notes: every remote call is `bash -lc` (claude isn't on the non-interactive
# ssh PATH). The remote command is base64-wrapped so args with any quoting survive the
# ssh → login-shell → bash hop. It only ever creates its OWN `claude-<project>` session;
# it never touches the studio rooms (kiracode/main/term1/term2).
set -u

REAL="$HOME/.local/bin/claude"   # real binary; $HOME → /Users/ed (Mac) or /home/ed (box)
qp() { printf '%q' "$1"; }

# --- local escape hatches -----------------------------------------------------
[ "${1:-}" = "--local" ] && { shift; exec "$REAL" "$@"; }
[ "${KIRA_CLAUDE_HOST:-}" = "local" ] && exec "$REAL" "$@"

# --- on the kira-box ITSELF, Claude runs natively (never ssh-loop into ourselves) --
# Gated on a box-only sentinel file, NOT on uname: every OTHER host — including Linux
# satellites like ms01 — must route INTO the box, not run its own local claude.
[ -f "$HOME/.kira/is-box" ] && exec "$REAL" "$@"

# --- resolve the box endpoint (kept OUT of this public repo → machine.env) -----
[ -f "$HOME/.kira/machine.env" ] && . "$HOME/.kira/machine.env" 2>/dev/null
host="${KIRA_B70_HOST:-${KIRA_BRAIN_HOST:+${KIRA_BRAIN_USER:-ed}@$KIRA_BRAIN_HOST}}"
if [ -z "${host:-}" ]; then
  echo "[claude] no kira-box endpoint configured — set KIRA_B70_HOST in ~/.kira/machine.env." >&2
  echo "[claude] to run the LOCAL claude on this machine instead: $REAL" >&2
  echo "[claude]   (or invoke it as: claude --local)" >&2
  exit 1
fi

# --- box unreachable → ERROR (never silently run local; Ed's rule) -------------
if ! /usr/bin/ssh -o BatchMode=yes -o ConnectTimeout=4 "$host" true 2>/dev/null; then
  echo "[claude] cannot reach kira-box ($host)." >&2
  echo "[claude] to run the LOCAL claude on this machine instead: $REAL" >&2
  echo "[claude]   (or invoke it as: claude --local)" >&2
  exit 1
fi

sshbase=(-o ConnectTimeout=10 -o ServerAliveInterval=20 -o ServerAliveCountMax=3)

# --- map Mac cwd → box project dir --------------------------------------------
case "$PWD" in
  /Users/ed/*) boxdir="/home/ed/${PWD#/Users/ed/}" ;;
  *)           boxdir="/home/ed/projects" ;;
esac

# run_remote <tty:yes|no> <remote-script> — base64-wrap so quoting always survives
run_remote() {
  local enc; enc=$(printf '%s' "$2" | base64 | tr -d '\n')
  if [ "$1" = yes ]; then
    exec /usr/bin/ssh -t "${sshbase[@]}" "$host" "bash -lc \"\$(echo $enc | base64 --decode)\""
  else
    exec /usr/bin/ssh "${sshbase[@]}" "$host" "bash -lc \"\$(echo $enc | base64 --decode)\""
  fi
}

# --- args present → ephemeral run on the box (headless for -p/--print) ---------
if [ "$#" -gt 0 ]; then
  headless=no
  for a in "$@"; do case "$a" in -p|--print) headless=yes ;; esac; done
  cmd="cd $(qp "$boxdir") 2>/dev/null || cd ~/projects || cd ~; exec claude"
  for a in "$@"; do cmd="$cmd $(qp "$a")"; done
  if [ "$headless" = yes ]; then run_remote no "$cmd"; else run_remote yes "$cmd"; fi
fi

# --- bare claude, tmux disabled → ephemeral --continue ------------------------
if [ "${KIRA_CLAUDE_TMUX:-1}" = 0 ]; then
  run_remote yes "cd $(qp "$boxdir") 2>/dev/null || cd ~/projects || cd ~; exec claude --continue"
fi

# --- bare claude → a NEW independent session each launch, in a -L kira tmux window
# Unique per launch (…-$$) so multiple `claude` in the SAME dir are INDEPENDENT
# sessions, not a re-attach to one shared PTY. All live on the -L kira socket so
# Kira/StudioControl can still observe them; reattach a dropped one via `tmux -L kira ls`.
# The pane runs claude under a login-INTERACTIVE zsh: an explicit new-session command
# bypasses default-command ("zsh -li"), and mise (node/python) is activated only in
# ~/.zshrc — without this the session inherits a stripped PATH with no node/bun and
# every Claude hook dies with "node: not found". Real binary by path, so a future
# ~/bin/claude on the box can never re-enter this shim.
base="${boxdir##*/}"; base="${base//[^A-Za-z0-9._-]/-}"; sess="claude-${base:-home}-$$"
conf="/home/ed/projects/kira-studio/kira.tmux.conf"
S="cd $(qp "$boxdir") 2>/dev/null || cd ~/projects || cd ~
tmux -L kira -f $(qp "$conf") new-session -d -s $(qp "$sess") -c $(qp "$boxdir") \"zsh -lic 'exec ~/.local/bin/claude'\"
tmux -L kira set-option -t $(qp "$sess") remain-on-exit off >/dev/null 2>&1 || true
exec tmux -L kira attach -t $(qp "$sess")"
run_remote yes "$S"
