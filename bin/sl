#!/bin/sh
# Toggle the Claude Code status line between its first row (default) and the full footer.
#   sl         toggle
#   sl --tmux  same as claude-tmux-ui: tap-to-toggle + touch scrolling in the running tmux
[ "${1:-}" = "--tmux" ] && exec "$(dirname "$0")/claude-tmux-ui"  # kept for muscle memory
exec python3 "$HOME/.claude/statusline.py" --toggle
