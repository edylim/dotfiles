#!/usr/bin/env bash
# Open the whole Kira Studio. Thin personal shim: the canonical launcher lives in
# the kira-studio repo ($KIRA_STUDIO_ROOT/bin/kira) — it owns the session template
# and pane wiring. This dotfiles entry point just sources machine.env (for
# KIRA_STUDIO_ROOT) and hands off. (Mirrors bin/kiracode shimming the kiracode repo.)
[ -f "$HOME/.kira/machine.env" ] && source "$HOME/.kira/machine.env"
exec "${KIRA_STUDIO_ROOT:-$HOME/projects/kira-studio}/bin/kira" "$@"
