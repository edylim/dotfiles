#!/usr/bin/env python3
"""Stream Kira's alerts (see kira-alert) to a client, for the Kira Studio app's SSH exec channel.

The app is a wrapper (Ed 09-29): it shows and plays what arrives and knows nothing about who
sent it or why, so the wording, the sources and new event types stay box-side. Output is framed:
one JSON header line per message, then exactly header["bytes"] bytes of WAV (0 = no voice).
Clients must ignore unknown types and fields. Messages:
  {"type":"alert","id":..,"title":..,"body":..,"bytes":N, ...extra fields}   + N wav bytes
  {"type":"ping","bytes":0}                                                  every 15 s
On start it sends the events newer than --after (the last id the client played) that are at
most --max-age seconds old, so a reconnect neither loses a fresh alert nor replays old ones.
usage: kira-alert-listen [--after ID] [--max-age 60]
"""
import argparse
import glob
import json
import os
import sys
import time

QUEUE = os.path.expanduser("~/.cache/kira-alert/queue")


def send(out, header, payload=b""):
    header = dict(header, bytes=len(payload))
    out.write(json.dumps(header).encode() + b"\n" + payload)
    out.flush()


def events_after(last):
    ids = sorted(os.path.basename(p)[:-5] for p in glob.glob(os.path.join(QUEUE, "*.json")))
    return [i for i in ids if int(i) > int(last)]


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--after", default="0")
    ap.add_argument("--max-age", type=float, default=60)
    a = ap.parse_args()
    os.makedirs(QUEUE, exist_ok=True)
    out = sys.stdout.buffer
    last = max(int(a.after), int((time.time() - a.max_age) * 1000))
    last_ping = time.monotonic()
    try:
        while True:
            for eid in events_after(last):
                try:
                    with open(os.path.join(QUEUE, eid + ".json")) as f:
                        event = json.load(f)
                    wav_path = os.path.join(QUEUE, eid + ".wav")
                    wav = open(wav_path, "rb").read() if os.path.exists(wav_path) else b""
                except (OSError, ValueError):
                    continue  # pruned or half-written; the json is written last, so rare
                send(out, dict(event, type="alert"), wav)
                last = int(eid)
            if time.monotonic() - last_ping >= 15:
                send(out, {"type": "ping"})
                last_ping = time.monotonic()
            time.sleep(0.25)
    except (BrokenPipeError, KeyboardInterrupt):
        pass


if __name__ == "__main__":
    main()
