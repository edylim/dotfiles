#!/usr/bin/env zsh
# kira-pane — keep a studio pane alive across program exit / Ctrl+C.
#
# Usage: kira-pane <label> <command> [args...]
#
# Runs <command>. When it exits — whether it quit normally or you Ctrl+C'd out —
# the pane is NOT destroyed: it drops to an interactive shell in the same pane so
# you can run terminal tasks. That shell has a `restart` (alias `r`) command that
# relaunches <command> (still wrapped, so it stays keep-alive). `exit`/Ctrl+D
# closes the pane normally when you actually want it gone.
emulate -L zsh
setopt no_nomatch

label="$1"; shift
cmd=("$@")

# The supervisor itself ignores SIGINT so an accidental Ctrl+C only reaches the
# child program (which handles it / exits) — it never kills this wrapper.
trap '' INT

# Transient ZDOTDIR for the drop-to-shell: source the user's real config (so
# normal terminal tasks/aliases work), then define restart in terms of THIS
# wrapper + the original command, and print a hint.
tmp="$(mktemp -d "${TMPDIR:-/tmp}/kira-pane.XXXXXX")"
{
  # Reset ZDOTDIR back to $HOME BEFORE sourcing the real rc. powerlevel10k keys
  # off $ZDOTDIR (instant-prompt cache + theme setup); leaving it pointed at our
  # temp dir loads aliases but silently drops p10k → a bare prompt. (verified)
  echo 'ZDOTDIR="$HOME"'
  # We print a "pane kept alive" hint after sourcing ~/.zshrc, which p10k's
  # instant prompt flags as "console output during init". Tell p10k to expect
  # it (quiet) — only in these wrapped drop-shells, not the user's normal shell.
  echo 'typeset -g POWERLEVEL9K_INSTANT_PROMPT=quiet'
  echo '[ -f "$HOME/.zshrc" ] && source "$HOME/.zshrc"'
  printf 'kira_restart(){ exec %q' "$0"
  printf ' %q' "$label" "${cmd[@]}"
  printf '; }\n'
  echo 'alias restart=kira_restart'
  echo 'alias r=kira_restart'
  printf 'print -P "%%F{244}[kira] %s stopped — pane kept alive. %%F{yellow}restart%%f%%F{244} (or r) to relaunch · exit closes the pane.%%f"\n' "$label"
} > "$tmp/.zshrc"

# Run the program, then drop into the interactive shell.
"${cmd[@]}"
ZDOTDIR="$tmp" exec zsh -i
