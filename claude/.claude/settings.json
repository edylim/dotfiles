{
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DO_NOT_TRACK": "1",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_GROWTHBOOK": "1",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(git *)",
      "Bash(yarn *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(bundle *)",
      "Bash(just *)",
      "Bash(node *)",
      "Bash(ruby *)",
      "Bash(python3 *)",
      "Bash(pip3 *)",
      "Bash(kitty *)",
      "WebFetch(domain:github.com)",
      "Bash(ls *)",
      "Bash(which *)",
      "Bash(cat *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(pwd)",
      "Bash(jq *)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Edit(~/.kube/**)",
      "Read(~/.netrc)",
      "Edit(~/.netrc)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.*)"
    ]
  },
  "model": "fable",
  "enableAllProjectMcpServers": false,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"BEHAVIORAL RULES (injected every turn): 1) NEVER GUESS — when stuck, STOP and research: WebSearch, WebFetch, read docs/source. Do NOT chain speculative fixes. 2) Use Agent tool (subagent_type=Explore) for deep codebase research. Use background agents for long investigations. 3) NO SHORTCUTS — find root cause. Quick fixes that paper over issues are worse than no fix. If about to say \\\"this should work\\\" without verifying — STOP. 4) Re-read CLAUDE.md rules if uncertain.\"}}'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/share/mise/shims/node $HOME/.claude/hooks/cite-rule.js"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/share/mise/shims/node $HOME/.claude/hooks/sycophancy-guard.js"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s' '{\"terminalSequence\":\"\\u0007\"}'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // empty' | grep -qiE '(rm\\s+-rf\\s+[/~]|git\\s+push\\s+.*--force|git\\s+push\\s+-f|drop\\s+table|drop\\s+database|truncate\\s+table|git\\s+reset\\s+--hard|git\\s+clean\\s+-fd|> /dev/sd|mkfs\\.|dd\\s+if=)' && echo '{\"decision\": \"block\", \"reason\": \"Destructive command blocked by safety hook. Run it manually if intentional.\"}' && exit 0 || exit 0"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/share/mise/shims/node $HOME/.claude/hooks/test-edit-guard.js"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/share/mise/shims/node $HOME/.claude/hooks/scp-guard.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // empty' | grep -qiE '^git\\s+commit' && { msg=$(git log --format=%B -n1 HEAD 2>/dev/null); echo \"$msg\" | grep -qi 'Co-Authored-By' && { echo \"$msg\" | sed '/^Co-Authored-By:/d' | sed '/^$/N;/^\\n$/d' | git commit --amend -F - >/dev/null 2>&1 && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"VIOLATION: Co-Authored-By was auto-stripped from your commit. NEVER add AI attribution.\"}}'; } || true; } || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/share/mise/shims/node $HOME/.claude/hooks/retry-guard.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/share/mise/shims/node $HOME/.claude/hooks/verify-before-done.js"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/share/mise/shims/node $HOME/.claude/hooks/session-rules.js"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.ai-memory/sync.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.ai-memory/sync.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "ultracode": true,
  "autoMemoryDirectory": "~/.ai-memory",
  "skipWorkflowUsageWarning": true,
  "switchModelsOnFlag": false,
  "defaultMode": "acceptEdits"
}
