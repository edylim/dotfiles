# Kira cockpit — kitty session (single-window workspace)
# Launch: kitty --session ~/.config/kitty/kira.session   (or the `kira` command)
#
# Layout (2560x1440 cockpit). The top-left avatar region is split three ways:
# the square avatar (wide, left), a narrow gauge strip (right), and a
# full-width text strip below.
#   ┌──────────┬──┬──────────────┬──────────────┐
#   │  avatar  │G │   term 1     │   term 2     │
#   │   1:1    │A │              │              │
#   ├──────────┴──┼──────────────┴──────────────┤
#   │ text strip  │                             │
#   ├─────────────┤        grumpyvim (nvim)     │
#   │ kira code    │                             │
#   └─────────────┴─────────────────────────────┘
#
# Build order is deliberate: the AVATAR pane seeds the whole top-left region so
# the text strip (hsplit) spans its full width, then the gauges are vsplit to
# the right of the avatar. Panes auto-fit, so the avatar restreams to size.
#
# Every pane runs under `kira-pane <label> <cmd>`: an accidental Ctrl+C (or
# quitting the program) does NOT destroy the pane — it drops to a shell with a
# `restart` command, so you can do terminal work and relaunch the tui/vim/stats.

layout splits

# 1. Seed pane — becomes the square AVATAR on the left of the top-left region.
launch --var window=avatar --title "kira avatar" /Users/ed/projects/anima/terminal/kira-pane avatar /Users/ed/projects/anima/terminal/kira-avatar --host REDACTED-B70

# 2. Vsplit — right region gets 72% so the left column is ~square.
launch --location=vsplit --bias=72 --var window=misc1 --title "term 1"

# 3. Hsplit the right region — grumpyvim takes the bottom 66%.
launch --location=hsplit --bias=66 --title grumpyvim /Users/ed/projects/anima/terminal/kira-pane grumpyvim /opt/homebrew/bin/nvim

# 4. Back to misc1 — vsplit for the second top-right terminal.
focus_matching_window var:window=misc1
launch --location=vsplit --bias=50 --var window=misc2 --title "term 2"

# 5. Back to the left column — hsplit so Kira Code takes the bottom-left half.
focus_matching_window var:window=avatar
launch --location=hsplit --bias=50 --var window=kiracode --title "kira" /Users/ed/projects/anima/terminal/kira-pane kiracode /Users/ed/bin/kiracode

# 6. Subdivide the top-left region: text strip takes the bottom 25% (full width).
focus_matching_window var:window=avatar
launch --location=hsplit --bias=25 --var window=textstrip --title "kira text" /Users/ed/projects/anima/terminal/kira-pane text /Users/ed/projects/anima/terminal/kira-stats --mode text --host REDACTED-B70

# 7. Split the remaining top region: gauges take the right 25%, avatar keeps left 75%.
focus_matching_window var:window=avatar
launch --location=vsplit --bias=25 --var window=gauge --title "kira gauges" /Users/ed/projects/anima/terminal/kira-pane gauges /Users/ed/projects/anima/terminal/kira-stats --mode gauges --host REDACTED-B70

# Land focus in Kira Code.
focus_matching_window var:window=kiracode
